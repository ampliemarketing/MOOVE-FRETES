VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Banco único MooveFretes (compartilhado com o app mobile) — ver
# moove-fretes-database/README.md para como criar o projeto e aplicar as
# migrations. Use os MESMOS valores no .env do app mobile.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# NUNCA adicionar serviceRoleKey aqui — usar apenas no backend/Edge Functions

# DEPRECIADO: a checagem de admin agora deve vir de `profiles.is_admin` /
# `public.is_admin()` no banco (ver moove-fretes-database/migrations/0006_admin_ops.sql),
# não mais de uma lista de e-mails no frontend. Mantido só enquanto
# AdminPage.tsx não for migrado (ver checklist de alto risco no README do banco).
VITE_ADMIN_EMAILS=admin@suaempresa.com.br,suporte@suaempresa.com.br
